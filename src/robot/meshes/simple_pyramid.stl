solid simple_pyramid

  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0.3 0.3 0
      vertex 0.3 0 0
    endloop
  endfacet

  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 0.3 0
      vertex 0.3 0.3 0
    endloop
  endfacet

  facet normal 0 -0.707 0.707
    outer loop
      vertex 0 0 0
      vertex 0.3 0 0
      vertex 0.15 0.15 0.5
    endloop
  endfacet

  facet normal 0.707 0 0.707
    outer loop
      vertex 0.3 0 0
      vertex 0.3 0.3 0
      vertex 0.15 0.15 0.5
    endloop
  endfacet

  facet normal 0 0.707 0.707
    outer loop
      vertex 0.3 0.3 0
      vertex 0 0.3 0
      vertex 0.15 0.15 0.5
    endloop
  endfacet

  facet normal -0.707 0 0.707
    outer loop
      vertex 0 0.3 0
      vertex 0 0 0
      vertex 0.15 0.15 0.5
    endloop
  endfacet

endsolid simple_pyramid
